# Node
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Database
DATABASE_URL="mysql://user:password@localhost:3306/kairo"

# Crypto — generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
ENCRYPTION_KEY=""
CSRF_SECRET=""
COOKIE_DOMAIN=""

# Mercado Libre
ML_APP_ID=""
ML_CLIENT_SECRET=""
ML_REDIRECT_URI="http://localhost:3000/api/auth/ml/callback"

# AliExpress
AE_APP_KEY=""
AE_APP_SECRET=""
AE_TRACKING_ID=""

# WhatsApp Cloud API (Meta)
WA_TOKEN=""
WA_PHONE_ID=""
WA_BUSINESS_ID=""
WA_WEBHOOK_VERIFY_TOKEN=""
WA_APP_SECRET=""

# MercadoPago
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_DEFAULT="hola@kairo.com.co"
RESEND_FROM_ALERTS="alertas@kairo.com.co"

# Observability
SENTRY_DSN=""
LOG_LEVEL="info"
LOGTAIL_TOKEN=""

# Rate limiting
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120

# Metrics endpoint protection
METRICS_TOKEN=""
